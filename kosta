"""
Модель «длинного человечка» с рисунка для Blender (2.8+ / 3.x / 4.x).

Запуск: Blender -> вкладка Scripting -> New -> вставить код -> Run Script (Alt+P).
Все размеры заданы в пикселях исходного рисунка и переводятся в метры,
поэтому пропорции можно подкрутить в блоке ПАРАМЕТРЫ.
"""
import math
import bpy

# ---------------------------------------------------------------- ПАРАМЕТРЫ
HEIGHT_M = 1.8            # итоговая высота модели в метрах
IMG_TOP, IMG_BOTTOM = 118, 575   # верх головы и низ ступней на рисунке (px)
CX = 245                  # ось симметрии на рисунке (px)
CLEAR_SCENE = False       # True -> удалить все объекты сцены перед созданием

S = HEIGHT_M / (IMG_BOTTOM - IMG_TOP)   # метров на пиксель


def X(px):
    return (px - CX) * S


def Z(py):
    return (IMG_BOTTOM - py) * S


def L(px):
    return px * S


# ---------------------------------------------------------------- МАТЕРИАЛЫ
def make_material(name, color, roughness=0.6):
    mat = bpy.data.materials.new(name)
    mat.use_nodes = True
    bsdf = mat.node_tree.nodes.get("Principled BSDF")
    if bsdf:
        bsdf.inputs["Base Color"].default_value = color
        bsdf.inputs["Roughness"].default_value = roughness
    mat.diffuse_color = color
    return mat


# ---------------------------------------------------------------- ПРИМИТИВЫ
def finish(obj, name, mat):
    obj.name = name
    obj.data.materials.append(mat)
    bpy.context.view_layer.objects.active = obj
    obj.select_set(True)
    bpy.ops.object.transform_apply(location=False, rotation=False, scale=True)
    bpy.ops.object.shade_smooth()
    obj.select_set(False)
    return obj


def ellipsoid(name, cx, cy, rx, rz, ry, mat, y=0.0, rot_z=0.0):
    """Эллипсоид. cx, cy — центр на рисунке (px), rx/rz/ry — полуоси (px)."""
    bpy.ops.mesh.primitive_uv_sphere_add(
        segments=32, ring_count=16, radius=1.0,
        location=(X(cx), y, Z(cy)),
    )
    obj = bpy.context.active_object
    obj.scale = (L(rx), L(ry), L(rz))
    obj.rotation_euler[2] = math.radians(rot_z)
    return finish(obj, name, mat)


def cylinder(name, cx, y_top, y_bot, r, mat, ry_factor=1.0, r_top=None):
    """Вертикальный цилиндр/конус между двумя высотами рисунка."""
    depth = L(y_bot - y_top)
    zc = (Z(y_top) + Z(y_bot)) / 2
    if r_top is None or r_top == r:
        bpy.ops.mesh.primitive_cylinder_add(
            vertices=32, radius=1.0, depth=1.0, location=(X(cx), 0, zc))
    else:
        bpy.ops.mesh.primitive_cone_add(
            vertices=32, radius1=1.0, radius2=r_top / r, depth=1.0,
            location=(X(cx), 0, zc))
    obj = bpy.context.active_object
    obj.scale = (L(r), L(r) * ry_factor, depth)
    return finish(obj, name, mat)


def head_surface_y(cx, cy, rx, rz, ry, px, py):
    """Y-координата поверхности эллипсоида головы (спереди, -Y) в точке (px, py)."""
    k = 1.0 - ((px - cx) / rx) ** 2 - ((py - cy) / rz) ** 2
    return -L(ry) * math.sqrt(max(k, 0.0))


# ---------------------------------------------------------------- СБОРКА
def build():
    if CLEAR_SCENE:
        bpy.ops.object.select_all(action="SELECT")
        bpy.ops.object.delete()

    skin = make_material("Skin", (0.78, 0.80, 0.82, 1.0), 0.7)
    dark = make_material("Dark", (0.02, 0.02, 0.02, 1.0), 0.4)

    parts = []

    # --- Голова (крупный овал) ---
    HX, HY, HRX, HRZ, HRY = 247, 173, 41, 55, 40
    parts.append(ellipsoid("Head", HX, HY, HRX, HRZ, HRY, skin))

    # --- Глаза (две точки) ---
    for side, ex in (("L", 231), ("R", 258)):
        ey = 187
        y = head_surface_y(HX, HY, HRX, HRZ, HRY, ex, ey)
        parts.append(ellipsoid(f"Eye_{side}", ex, ey, 4.5, 5.5, 3, dark, y=y + L(0.5)))

    # --- Рот (короткая горизонтальная линия) ---
    mx, my = 242, 207
    y = head_surface_y(HX, HY, HRX, HRZ, HRY, mx, my)
    parts.append(ellipsoid("Mouth", mx, my, 14, 1.8, 3, dark, y=y + L(0.5)))

    # --- Шея ---
    parts.append(cylinder("Neck", 245, 222, 255, 9, skin, ry_factor=0.9))

    # --- Торс (узкий, слегка сужается книзу) ---
    parts.append(cylinder("Torso", 243, 245, 400, 32, skin,
                          ry_factor=0.55, r_top=24))

    # --- Руки: тонкие вдоль тела, кисти — округлые «варежки» ---
    for side, ax in (("L", 211), ("R", 277)):
        parts.append(cylinder(f"Arm_{side}", ax, 255, 395, 6.5, skin))
        parts.append(ellipsoid(f"Hand_{side}", ax, 412, 13, 17, 11, skin))

    # --- Ноги: две длинные тонкие, вплотную друг к другу ---
    for side, lx in (("L", 231), ("R", 257)):
        parts.append(cylinder(f"Leg_{side}", lx, 385, 562, 12.5, skin,
                              ry_factor=0.85))

    # --- Ступни: плоские овалы, развёрнутые наружу ---
    parts.append(ellipsoid("Foot_L", 216, 562, 23, 11, 20, skin,
                           y=-L(8), rot_z=-12))
    parts.append(ellipsoid("Foot_R", 272, 562, 23, 11, 20, skin,
                           y=-L(8), rot_z=12))

    # --- Группировка под одним Empty для удобного перемещения ---
    root = bpy.data.objects.new("Stickman", None)
    bpy.context.collection.objects.link(root)
    for p in parts:
        p.parent = root

    # Опционально: объединить в один меш (раскомментируйте)
    # bpy.ops.object.select_all(action="DESELECT")
    # for p in parts:
    #     p.select_set(True)
    # bpy.context.view_layer.objects.active = parts[0]
    # bpy.ops.object.join()

    print("Готово: объект 'Stickman' создан.")


if __name__ == "__main__":
    build()
