"""
Человечек с рисунка для Blender (2.81+ / 3.x / 4.x) — версия 2.

Что исправлено относительно первой версии:
  * руки теперь растут из плеч (есть широкая «плечевая» часть, руки с ней перекрываются),
    а кисти насажены на концы рук;
  * добавлен таз, ноги плавно вырастают из него и сужаются к щиколоткам;
  * ступни перекрывают низ ног;
  * все части тела сливаются в ОДИН цельный меш через Voxel Remesh,
    так что никаких «висюлек» не остаётся;
  * глаза и рот остаются отдельными объектами (чёрный материал) и привязаны к телу.

Запуск: Blender -> вкладка Scripting -> New -> вставить код -> Run Script (Alt+P).
Лицо смотрит в сторону -Y (вид спереди: Numpad 1).
"""
import math
import bpy
from mathutils import Vector

# ---------------------------------------------------------------- ПАРАМЕТРЫ
HEIGHT_M = 1.8             # высота модели, м
IMG_TOP, IMG_BOTTOM = 118, 575   # верх головы / низ ступней на рисунке (px)
CX = 245                   # ось симметрии (px)
CLEAR_SCENE = False        # True -> очистить сцену перед созданием
MERGE_BODY = True          # True -> слить тело в один цельный меш
VOXEL_SIZE = 0.006         # детализация слияния, м (меньше = подробнее, но тяжелее)

S = HEIGHT_M / (IMG_BOTTOM - IMG_TOP)   # метров на пиксель


def X(px):
    return (px - CX) * S


def Z(py):
    return (IMG_BOTTOM - py) * S


def L(px):
    return px * S


# ---------------------------------------------------------------- МАТЕРИАЛЫ
def make_material(name, color, roughness=0.6):
    mat = bpy.data.materials.new(name)
    mat.use_nodes = True
    bsdf = mat.node_tree.nodes.get("Principled BSDF")
    if bsdf:
        bsdf.inputs["Base Color"].default_value = color
        bsdf.inputs["Roughness"].default_value = roughness
    mat.diffuse_color = color
    return mat


# ---------------------------------------------------------------- ПРИМИТИВЫ
def finish(obj, name, mat):
    obj.name = name
    obj.data.materials.append(mat)
    bpy.ops.object.select_all(action="DESELECT")
    obj.select_set(True)
    bpy.context.view_layer.objects.active = obj
    bpy.ops.object.transform_apply(location=False, rotation=False, scale=True)
    bpy.ops.object.shade_smooth()
    obj.select_set(False)
    return obj


def ellipsoid(name, cx, cy, rx, rz, ry, mat, y=0.0, rot_z=0.0):
    """Эллипсоид. cx, cy — центр на рисунке (px); rx, rz, ry — полуоси (px)."""
    bpy.ops.mesh.primitive_uv_sphere_add(
        segments=48, ring_count=24, radius=1.0, location=(X(cx), y, Z(cy)))
    obj = bpy.context.active_object
    obj.scale = (L(rx), L(ry), L(rz))
    obj.rotation_euler[2] = math.radians(rot_z)
    return finish(obj, name, mat)


def vert_cone(name, cx, y_top, y_bot, r_top, r_bot, mat, ry_factor=1.0):
    """Вертикальный усечённый конус (радиусы в px). ry_factor сплющивает по глубине."""
    bpy.ops.mesh.primitive_cone_add(
        vertices=48,
        radius1=L(r_bot), radius2=L(r_top), depth=L(y_bot - y_top),
        location=(X(cx), 0.0, (Z(y_top) + Z(y_bot)) / 2))
    obj = bpy.context.active_object
    obj.scale = (1.0, ry_factor, 1.0)
    return finish(obj, name, mat)


def limb(name, p1, p2, r1, r2, mat):
    """Наклонная округлая «трубка» от точки p1 до p2 (точки — (x, y) на рисунке)."""
    a = Vector((X(p1[0]), 0.0, Z(p1[1])))
    b = Vector((X(p2[0]), 0.0, Z(p2[1])))
    d = b - a
    bpy.ops.mesh.primitive_cone_add(
        vertices=32, radius1=L(r1), radius2=L(r2), depth=d.length,
        location=(a + b) / 2)
    obj = bpy.context.active_object
    # локальная +Z смотрит от p1 к p2 (радиус r1 у p1, r2 у p2)
    obj.rotation_euler = d.to_track_quat("Z", "Y").to_euler()
    return finish(obj, name, mat)


def head_surface_y(cx, cy, rx, rz, ry, px, py):
    """Y поверхности головы спереди (-Y) в точке рисунка (px, py)."""
    k = 1.0 - ((px - cx) / rx) ** 2 - ((py - cy) / rz) ** 2
    return -L(ry) * math.sqrt(max(k, 0.0))


def merge_into_one(parts, name, mat):
    """Join + Voxel Remesh: перекрывающиеся части превращаются в один цельный меш."""
    bpy.ops.object.select_all(action="DESELECT")
    for p in parts:
        p.select_set(True)
    bpy.context.view_layer.objects.active = parts[0]
    bpy.ops.object.join()
    body = bpy.context.active_object
    body.name = name

    mod = body.modifiers.new("Merge", "REMESH")
    mod.mode = "VOXEL"
    mod.voxel_size = VOXEL_SIZE
    mod.adaptivity = 0.0
    bpy.ops.object.modifier_apply(modifier=mod.name)

    # после remesh слоты материалов могут быть сброшены — задаём заново
    body.data.materials.clear()
    body.data.materials.append(mat)
    bpy.ops.object.shade_smooth()
    return body


# ---------------------------------------------------------------- СБОРКА
def build():
    if CLEAR_SCENE:
        bpy.ops.object.select_all(action="SELECT")
        bpy.ops.object.delete()

    skin = make_material("Skin", (0.78, 0.80, 0.82, 1.0), 0.7)
    dark = make_material("Dark", (0.02, 0.02, 0.02, 1.0), 0.4)

    body_parts = []

    # --- Голова ---
    HX, HY, HRX, HRZ, HRY = 245, 173, 41, 55, 40
    body_parts.append(ellipsoid("Head", HX, HY, HRX, HRZ, HRY, skin))

    # --- Шея (входит и в голову, и в плечи) ---
    body_parts.append(vert_cone("Neck", 245, 215, 262, 9, 10, skin, ry_factor=0.9))

    # --- Плечи: широкий овал, из которого растут руки ---
    body_parts.append(ellipsoid("Shoulders", 245, 264, 37, 22, 19, skin))

    # --- Торс: сужается к талии ---
    body_parts.append(vert_cone("Torso", 245, 262, 405, 30, 25, skin, ry_factor=0.62))

    # --- Таз: перекрывает верх обеих ног ---
    body_parts.append(ellipsoid("Pelvis", 245, 402, 30, 20, 17, skin))

    # --- Руки: от плеча чуть наружу к кисти, кисти насажены на концы ---
    for side, sx, hx in (("L", 216, 207), ("R", 274, 283)):
        body_parts.append(limb(f"Arm_{side}", (sx, 262), (hx, 404), 8, 5.5, skin))
        body_parts.append(ellipsoid(f"Hand_{side}", hx, 413, 12, 17, 10, skin))

    # --- Ноги: толще у бедра, тоньше у щиколотки, между собой — небольшой зазор ---
    for side, lx in (("L", 231.5), ("R", 258.5)):
        body_parts.append(vert_cone(f"Leg_{side}", lx, 395, 558, 14, 9.5, skin,
                                    ry_factor=0.9))

    # --- Ступни: плоские овалы, развёрнутые наружу, перекрывают низ ног ---
    body_parts.append(ellipsoid("Foot_L", 219, 564, 23, 11, 20, skin,
                                y=-L(8), rot_z=-12))
    body_parts.append(ellipsoid("Foot_R", 271, 564, 23, 11, 20, skin,
                                y=-L(8), rot_z=12))

    # --- Слияние в одно тело ---
    if MERGE_BODY:
        body = merge_into_one(body_parts, "Stickman_Body", skin)
        body_objs = [body]
    else:
        body_objs = body_parts

    # --- Лицо (отдельные объекты, чуть утоплены в голову) ---
    face = []
    for side, ex in (("L", 231), ("R", 259)):
        ey = 187
        y = head_surface_y(HX, HY, HRX, HRZ, HRY, ex, ey)
        face.append(ellipsoid(f"Eye_{side}", ex, ey, 4.5, 5.5, 3, dark, y=y + L(1.2)))

    mx, my = 244, 207
    y = head_surface_y(HX, HY, HRX, HRZ, HRY, mx, my)
    face.append(ellipsoid("Mouth", mx, my, 14, 1.8, 3, dark, y=y + L(1.2)))

    # --- Всё под одним Empty, чтобы двигать модель целиком ---
    root = bpy.data.objects.new("Stickman", None)
    bpy.context.collection.objects.link(root)
    for obj in body_objs + face:
        obj.parent = root

    bpy.ops.object.select_all(action="DESELECT")
    print("Готово: объект 'Stickman' создан.")


if __name__ == "__main__":
    build()
