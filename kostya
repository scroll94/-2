"""
Человечек для Blender (2.81+ / 3.x / 4.x) — версия 3.

Что изменено относительно версии 2:
  * убран таз («трусы») — теперь ноги вырастают прямо из торса;
  * добавлена чёрная обводка (метод inverted hull: Solidify + чёрный материал).
    Работает и в EEVEE, и в Cycles. Толщину можно менять в модификаторе "Outline"
    (параметр Thickness) или константой OUTLINE_THICKNESS ниже.

Запуск: Blender -> вкладка Scripting -> New -> вставить код -> Run Script (Alt+P).
Лицо смотрит в сторону -Y (вид спереди: Numpad 1).
"""
import math
import bpy
from mathutils import Vector

# ---------------------------------------------------------------- ПАРАМЕТРЫ
HEIGHT_M = 1.8             # высота модели, м
IMG_TOP, IMG_BOTTOM = 118, 575   # верх головы / низ ступней на рисунке (px)
CX = 245                   # ось симметрии (px)
CLEAR_SCENE = False        # True -> очистить сцену перед созданием
MERGE_BODY = True          # True -> слить тело в один цельный меш
VOXEL_SIZE = 0.006         # детализация слияния, м (меньше = подробнее, но тяжелее)
OUTLINE_MODE = "HULL"      # "HULL" — обводка геометрией (видна и во вьюпорте)
                           # "FREESTYLE" — линия только по контуру, видна при рендере (F12)
OUTLINE_THICKNESS = 0.006  # толщина обводки для HULL, м
FREESTYLE_PX = 3.0         # толщина линии для FREESTYLE, px
SMOOTH_AFTER_MERGE = True  # слегка сгладить стыки после слияния

S = HEIGHT_M / (IMG_BOTTOM - IMG_TOP)   # метров на пиксель


def X(px):
    return (px - CX) * S


def Z(py):
    return (IMG_BOTTOM - py) * S


def L(px):
    return px * S


# ---------------------------------------------------------------- МАТЕРИАЛЫ
def make_material(name, color, roughness=0.6):
    mat = bpy.data.materials.new(name)
    mat.use_nodes = True
    bsdf = mat.node_tree.nodes.get("Principled BSDF")
    if bsdf:
        bsdf.inputs["Base Color"].default_value = color
        bsdf.inputs["Roughness"].default_value = roughness
    mat.diffuse_color = color
    return mat


def make_outline_material():
    """Чёрный материал для обводки: обратные грани оболочки скрыты (прозрачные)."""
    mat = bpy.data.materials.new("Outline")
    mat.use_nodes = True
    nt = mat.node_tree
    nt.nodes.clear()

    out = nt.nodes.new("ShaderNodeOutputMaterial")
    geo = nt.nodes.new("ShaderNodeNewGeometry")
    mix = nt.nodes.new("ShaderNodeMixShader")
    black = nt.nodes.new("ShaderNodeEmission")
    clear = nt.nodes.new("ShaderNodeBsdfTransparent")

    black.inputs["Color"].default_value = (0.0, 0.0, 0.0, 1.0)
    black.inputs["Strength"].default_value = 1.0

    nt.links.new(geo.outputs["Backfacing"], mix.inputs["Fac"])
    nt.links.new(black.outputs["Emission"], mix.inputs[1])   # лицевая грань -> чёрный
    nt.links.new(clear.outputs["BSDF"], mix.inputs[2])       # обратная -> прозрачно
    nt.links.new(mix.outputs["Shader"], out.inputs["Surface"])

    # для EEVEE
    mat.use_backface_culling = True
    try:
        mat.blend_method = "HASHED"      # Blender < 4.2
    except Exception:
        pass
    try:
        mat.surface_render_method = "DITHERED"   # Blender 4.2+
    except Exception:
        pass
    mat.diffuse_color = (0.0, 0.0, 0.0, 1.0)
    return mat


def add_outline(obj, outline_mat):
    """Обводка: Solidify со вывернутыми нормалями, оболочка наружу, второй материал."""
    obj.data.materials.append(outline_mat)
    slot = len(obj.data.materials) - 1

    mod = obj.modifiers.new("Outline", "SOLIDIFY")
    mod.thickness = OUTLINE_THICKNESS
    mod.offset = 1.0                 # оболочка растёт наружу
    mod.use_flip_normals = True
    mod.use_rim = True
    mod.material_offset = slot       # оболочке достаётся материал обводки
    mod.material_offset_rim = slot
    return mod


def enable_viewport_culling():
    """Во вьюпорте скрываем «передние» грани оболочки — остаётся только контур по краю."""
    for screen in bpy.data.screens:
        for area in screen.areas:
            if area.type == "VIEW_3D":
                for space in area.spaces:
                    if space.type == "VIEW_3D":
                        space.shading.show_backface_culling = True


def setup_freestyle():
    """2D-обводка: линия только по силуэту и границам (рендер F12)."""
    scene = bpy.context.scene
    scene.render.use_freestyle = True
    scene.render.line_thickness_mode = "ABSOLUTE"
    scene.render.line_thickness = FREESTYLE_PX
    vl = bpy.context.view_layer
    vl.use_freestyle = True
    fs = vl.freestyle_settings
    ls = fs.linesets.active or fs.linesets.new("Outline")
    ls.select_silhouette = True
    ls.select_border = True
    ls.select_crease = False
    ls.select_contour = False
    ls.select_external_contour = False
    ls.select_material_boundary = False
    ls.select_edge_mark = False
    ls.linestyle.color = (0.0, 0.0, 0.0)
    ls.linestyle.thickness = FREESTYLE_PX


# ---------------------------------------------------------------- ПРИМИТИВЫ
def finish(obj, name, mat):
    obj.name = name
    obj.data.materials.append(mat)
    bpy.ops.object.select_all(action="DESELECT")
    obj.select_set(True)
    bpy.context.view_layer.objects.active = obj
    bpy.ops.object.transform_apply(location=False, rotation=False, scale=True)
    bpy.ops.object.shade_smooth()
    obj.select_set(False)
    return obj


def ellipsoid(name, cx, cy, rx, rz, ry, mat, y=0.0, rot_z=0.0):
    """Эллипсоид. cx, cy — центр на рисунке (px); rx, rz, ry — полуоси (px)."""
    bpy.ops.mesh.primitive_uv_sphere_add(
        segments=48, ring_count=24, radius=1.0, location=(X(cx), y, Z(cy)))
    obj = bpy.context.active_object
    obj.scale = (L(rx), L(ry), L(rz))
    obj.rotation_euler[2] = math.radians(rot_z)
    return finish(obj, name, mat)


def vert_cone(name, cx, y_top, y_bot, r_top, r_bot, mat, ry_factor=1.0):
    """Вертикальный усечённый конус (радиусы в px). ry_factor сплющивает по глубине."""
    bpy.ops.mesh.primitive_cone_add(
        vertices=48,
        radius1=L(r_bot), radius2=L(r_top), depth=L(y_bot - y_top),
        location=(X(cx), 0.0, (Z(y_top) + Z(y_bot)) / 2))
    obj = bpy.context.active_object
    obj.scale = (1.0, ry_factor, 1.0)
    return finish(obj, name, mat)


def limb(name, p1, p2, r1, r2, mat):
    """Наклонная округлая «трубка» от точки p1 до p2 (точки — (x, y) на рисунке)."""
    a = Vector((X(p1[0]), 0.0, Z(p1[1])))
    b = Vector((X(p2[0]), 0.0, Z(p2[1])))
    d = b - a
    bpy.ops.mesh.primitive_cone_add(
        vertices=32, radius1=L(r1), radius2=L(r2), depth=d.length,
        location=(a + b) / 2)
    obj = bpy.context.active_object
    obj.rotation_euler = d.to_track_quat("Z", "Y").to_euler()
    return finish(obj, name, mat)


def head_surface_y(cx, cy, rx, rz, ry, px, py):
    """Y поверхности головы спереди (-Y) в точке рисунка (px, py)."""
    k = 1.0 - ((px - cx) / rx) ** 2 - ((py - cy) / rz) ** 2
    return -L(ry) * math.sqrt(max(k, 0.0))


def merge_into_one(parts, name, mat):
    """Join + Voxel Remesh: перекрывающиеся части превращаются в один цельный меш."""
    bpy.ops.object.select_all(action="DESELECT")
    for p in parts:
        p.select_set(True)
    bpy.context.view_layer.objects.active = parts[0]
    bpy.ops.object.join()
    body = bpy.context.active_object
    body.name = name

    mod = body.modifiers.new("Merge", "REMESH")
    mod.mode = "VOXEL"
    mod.voxel_size = VOXEL_SIZE
    mod.adaptivity = 0.0
    bpy.ops.object.modifier_apply(modifier=mod.name)

    if SMOOTH_AFTER_MERGE:
        sm = body.modifiers.new("Smooth", "SMOOTH")
        sm.factor = 0.5
        sm.iterations = 8
        bpy.ops.object.modifier_apply(modifier=sm.name)

    body.data.materials.clear()
    body.data.materials.append(mat)
    bpy.ops.object.shade_smooth()
    return body


# ---------------------------------------------------------------- СБОРКА
def build():
    if CLEAR_SCENE:
        bpy.ops.object.select_all(action="SELECT")
        bpy.ops.object.delete()

    skin = make_material("Skin", (0.78, 0.80, 0.82, 1.0), 0.7)
    dark = make_material("Dark", (0.02, 0.02, 0.02, 1.0), 0.4)
    outline_mat = make_outline_material()

    body_parts = []

    # --- Голова ---
    HX, HY, HRX, HRZ, HRY = 245, 173, 41, 55, 40
    body_parts.append(ellipsoid("Head", HX, HY, HRX, HRZ, HRY, skin))

    # --- Шея ---
    body_parts.append(vert_cone("Neck", 245, 215, 262, 9, 10, skin, ry_factor=0.9))

    # --- Плечи ---
    body_parts.append(ellipsoid("Shoulders", 245, 264, 37, 22, 19, skin))

    # --- Торс: сужается к талии и уходит в ноги (таза-«трусов» больше нет) ---
    body_parts.append(vert_cone("Torso", 245, 262, 392, 30, 25, skin, ry_factor=0.52))

    # --- Руки ---
    for side, sx, hx in (("L", 216, 207), ("R", 274, 283)):
        body_parts.append(limb(f"Arm_{side}", (sx, 262), (hx, 404), 8, 5.5, skin))
        body_parts.append(ellipsoid(f"Hand_{side}", hx, 413, 12, 17, 10, skin))

    # --- Ноги: начинаются выше, заходят внутрь торса и сливаются с ним ---
    for side, lx in (("L", 231.5), ("R", 258.5)):
        body_parts.append(vert_cone(f"Leg_{side}", lx, 372, 558, 14, 9.5, skin,
                                    ry_factor=0.9))

    # --- Ступни ---
    body_parts.append(ellipsoid("Foot_L", 219, 564, 23, 11, 20, skin,
                                y=-L(8), rot_z=-12))
    body_parts.append(ellipsoid("Foot_R", 271, 564, 23, 11, 20, skin,
                                y=-L(8), rot_z=12))

    # --- Слияние в одно тело + обводка ---
    if MERGE_BODY:
        body = merge_into_one(body_parts, "Stickman_Body", skin)
        body_objs = [body]
    else:
        body_objs = body_parts

    if OUTLINE_MODE == "HULL":
        for o in body_objs:
            add_outline(o, outline_mat)
        enable_viewport_culling()
    else:
        setup_freestyle()

    # --- Лицо ---
    face = []
    for side, ex in (("L", 231), ("R", 259)):
        ey = 187
        y = head_surface_y(HX, HY, HRX, HRZ, HRY, ex, ey)
        face.append(ellipsoid(f"Eye_{side}", ex, ey, 4.5, 5.5, 3, dark, y=y + L(1.2)))

    mx, my = 244, 207
    y = head_surface_y(HX, HY, HRX, HRZ, HRY, mx, my)
    face.append(ellipsoid("Mouth", mx, my, 14, 1.8, 3, dark, y=y + L(1.2)))

    # --- Всё под одним Empty ---
    root = bpy.data.objects.new("Stickman", None)
    bpy.context.collection.objects.link(root)
    for obj in body_objs + face:
        obj.parent = root

    bpy.ops.object.select_all(action="DESELECT")
    print("Готово: объект 'Stickman' создан (с чёрной обводкой, без таза).")


if __name__ == "__main__":
    build()
